@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
if(@TK4CPP_ZIP_USES_VENDORED_LIBZIP@)
    # libzip is bundled in this package (static): only its own dependencies are needed.
    foreach(_tk4cpp_zip_pkg IN ITEMS @TK4CPP_ZIP_VENDORED_PACKAGES@)
        find_dependency(${_tk4cpp_zip_pkg})
    endforeach()
else()
    find_dependency(libzip 1.11)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/TK4CPP_ZipTargets.cmake")
add_library(TK4CPP::Zip ALIAS TK4CPP::Zip_@TK4CPP_ZIP_DEFAULT_FLAVOUR@)
