@PACKAGE_INIT@

# TK4CPP_LoggingConfig.cmake
# Usage: find_package(TK4CPP_Logging REQUIRED)
#        target_link_libraries(app PRIVATE TK4CPP::Logging)   # or TK4CPP::Logging_static

include(CMakeFindDependencyMacro)

find_dependency(Threads)
if("@TK4CPP_LOGGING_USE_SYSTEM_SPDLOG@")
    find_dependency(spdlog)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/TK4CPP_LoggingTargets.cmake")

check_required_components(TK4CPP_Logging)
